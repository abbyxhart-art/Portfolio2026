{
  "_meta": {
    "format": "DTCG-compatible",
    "version": "1.0.0",
    "cssVarStrategy": "kebab-path — color.text.primary → --color-text-primary"
  },

  "primitive": {
    "color": {
      "neutral": {
        "0":   { "$value": "#faf9ff",  "$type": "color" },
        "50":  { "$value": "#eeedf5",  "$type": "color" },
        "100": { "$value": "#c1becb",  "$type": "color" },
        "200": { "$value": "#b8b4c5",  "$type": "color" },
        "300": { "$value": "#908e99",  "$type": "color" },
        "400": { "$value": "#7e7c87",  "$type": "color" },
        "500": { "$value": "#585564",  "$type": "color" },
        "600": { "$value": "#302f34",  "$type": "color" },
        "700": { "$value": "#1c1b1f",  "$type": "color" },
        "800": { "$value": "#161617",  "$type": "color" },
        "900": { "$value": "#171717",  "$type": "color" }
      },
      "purple": {
        "100": { "$value": "#afa4d8",  "$type": "color" },
        "200": { "$value": "#9a47ff",  "$type": "color" }
      },
      "alpha": {
        "purple": {
          "4":  { "$value": "rgba(219,189,254,0.05)",  "$type": "color" },
          "8":  { "$value": "rgba(175,164,216,0.08)",  "$type": "color" },
          "15": { "$value": "rgba(175,164,216,0.15)",  "$type": "color" },
          "20": { "$value": "rgba(175,164,216,0.20)",  "$type": "color" }
        },
        "neutral": {
          "8":  { "$value": "rgba(88,85,100,0.08)",   "$type": "color" },
          "15": { "$value": "rgba(88,85,100,0.15)",   "$type": "color" },
          "20": { "$value": "rgba(88,85,100,0.20)",   "$type": "color" },
          "50": { "$value": "rgba(144,142,153,0.5)",  "$type": "color" }
        },
        "dark": {
          "0":  { "$value": "rgba(23,23,23,0)",    "$type": "color" },
          "35": { "$value": "rgba(23,23,23,0.35)", "$type": "color" },
          "85": { "$value": "rgba(23,23,23,0.85)", "$type": "color" },
          "98": { "$value": "rgba(23,23,23,0.98)", "$type": "color" }
        }
      }
    },
    "font": {
      "family": {
        "display": { "$value": "'Inter Tight', sans-serif", "$type": "fontFamily" },
        "body":    { "$value": "'Inter Tight', sans-serif", "$type": "fontFamily" }
      },
      "size": {
        "xs":  { "$value": "10px", "$type": "dimension" },
        "sm":  { "$value": "12px", "$type": "dimension" },
        "md":  { "$value": "14px", "$type": "dimension" },
        "base":{ "$value": "15px", "$type": "dimension" },
        "lg":  { "$value": "16px", "$type": "dimension" },
        "xl":  { "$value": "17px", "$type": "dimension" },
        "2xl": { "$value": "18px", "$type": "dimension" },
        "3xl": { "$value": "20px", "$type": "dimension" },
        "4xl": { "$value": "24px", "$type": "dimension" },
        "5xl": { "$value": "28px", "$type": "dimension" },
        "6xl": { "$value": "32px", "$type": "dimension" },
        "7xl": { "$value": "40px", "$type": "dimension" },
        "8xl": { "$value": "52px", "$type": "dimension" }
      },
      "weight": {
        "light":   { "$value": 300, "$type": "fontWeight" },
        "regular": { "$value": 350, "$type": "fontWeight" },
        "medium":  { "$value": 400, "$type": "fontWeight" }
      },
      "leading": {
        "none":    { "$value": 1,    "$type": "number" },
        "tight":   { "$value": 1.1,  "$type": "number" },
        "snug":    { "$value": 1.2,  "$type": "number" },
        "normal":  { "$value": 1.4,  "$type": "number" },
        "relaxed": { "$value": 1.5,  "$type": "number" },
        "loose":   { "$value": 1.65, "$type": "number" }
      },
      "tracking": {
        "tight":  { "$value": "-0.01em", "$type": "dimension" },
        "normal": { "$value": "0em",     "$type": "dimension" },
        "wide":   { "$value": "0.08em",  "$type": "dimension" }
      }
    },
    "space": {
      "1":  { "$value": "4px",   "$type": "dimension" },
      "2":  { "$value": "8px",   "$type": "dimension" },
      "3":  { "$value": "12px",  "$type": "dimension" },
      "4":  { "$value": "16px",  "$type": "dimension" },
      "5":  { "$value": "20px",  "$type": "dimension" },
      "6":  { "$value": "24px",  "$type": "dimension" },
      "7":  { "$value": "32px",  "$type": "dimension" },
      "8":  { "$value": "40px",  "$type": "dimension" },
      "9":  { "$value": "48px",  "$type": "dimension" },
      "10": { "$value": "64px",  "$type": "dimension" },
      "11": { "$value": "80px",  "$type": "dimension" },
      "12": { "$value": "96px",  "$type": "dimension" }
    },
    "radius": {
      "xs":   { "$value": "4px",    "$type": "dimension" },
      "sm":   { "$value": "8px",    "$type": "dimension" },
      "md":   { "$value": "12px",   "$type": "dimension" },
      "lg":   { "$value": "24px",   "$type": "dimension" },
      "xl":   { "$value": "50px",   "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "motion": {
      "duration": {
        "instant": { "$value": "100ms",  "$type": "duration" },
        "fast":    { "$value": "150ms",  "$type": "duration" },
        "base":    { "$value": "200ms",  "$type": "duration" },
        "slow":    { "$value": "400ms",  "$type": "duration" },
        "enter":   { "$value": "1400ms", "$type": "duration" }
      },
      "easing": {
        "default":  { "$value": "cubic-bezier(0.33, 0, 0, 1)", "$type": "string" },
        "out":      { "$value": "ease-out",                    "$type": "string" },
        "in":       { "$value": "ease-in",                     "$type": "string" },
        "linear":   { "$value": "linear",                      "$type": "string" }
      }
    }
  },

  "color": {
    "background": {
      "page": { "$value": "{primitive.color.neutral.900}", "$type": "color" }
    },

    "surface": {
      "primary": {
        "default": { "$value": "{primitive.color.neutral.900}", "$type": "color" }
      },
      "secondary": {
        "default": { "$value": "{primitive.color.neutral.800}", "$type": "color" },
        "hover":   { "$value": "{primitive.color.alpha.neutral.15}", "$type": "color" },
        "active":  { "$value": "{primitive.color.alpha.neutral.20}", "$type": "color" }
      },
      "tertiary": {
        "default": { "$value": "{primitive.color.neutral.700}", "$type": "color" }
      },
      "overlay": {
        "default": { "$value": "{primitive.color.alpha.dark.85}", "$type": "color" },
        "strong":  { "$value": "{primitive.color.alpha.dark.98}", "$type": "color" },
        "fade":    { "$value": "{primitive.color.alpha.dark.35}", "$type": "color" }
      }
    },

    "text": {
      "primary":   { "$value": "{primitive.color.neutral.0}",   "$type": "color" },
      "secondary": { "$value": "{primitive.color.neutral.300}", "$type": "color" },
      "tertiary":  { "$value": "{primitive.color.neutral.400}", "$type": "color" },
      "disabled":  { "$value": "{primitive.color.neutral.500}", "$type": "color" },
      "inverse":   { "$value": "{primitive.color.neutral.900}", "$type": "color" },
      "accent":    { "$value": "{primitive.color.purple.100}",  "$type": "color" }
    },

    "border": {
      "default": { "$value": "{primitive.color.neutral.600}", "$type": "color" },
      "subtle":  { "$value": "{primitive.color.alpha.neutral.15}", "$type": "color" },
      "strong":  { "$value": "{primitive.color.neutral.500}", "$type": "color" },
      "focus":   { "$value": "{primitive.color.purple.100}",  "$type": "color" }
    },

    "accent": {
      "default": { "$value": "{primitive.color.purple.100}",          "$type": "color" },
      "vibrant": { "$value": "{primitive.color.purple.200}",          "$type": "color" },
      "subtle":  { "$value": "{primitive.color.alpha.purple.8}",      "$type": "color" },
      "muted":   { "$value": "{primitive.color.alpha.purple.15}",     "$type": "color" },
      "strong":  { "$value": "{primitive.color.alpha.purple.20}",     "$type": "color" }
    },

    "button": {
      "primary": {
        "default": {
          "background": { "$value": "{primitive.color.neutral.0}",   "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.900}", "$type": "color" },
          "border":     { "$value": "transparent",                    "$type": "color" }
        },
        "hover": {
          "background": { "$value": "{primitive.color.neutral.50}",  "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.900}", "$type": "color" },
          "border":     { "$value": "transparent",                    "$type": "color" }
        },
        "disabled": {
          "background": { "$value": "{primitive.color.alpha.neutral.20}", "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.500}",       "$type": "color" },
          "border":     { "$value": "transparent",                          "$type": "color" }
        }
      },
      "secondary": {
        "default": {
          "background": { "$value": "transparent",                        "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.0}",        "$type": "color" },
          "border":     { "$value": "{primitive.color.neutral.600}",      "$type": "color" }
        },
        "hover": {
          "background": { "$value": "{primitive.color.alpha.neutral.8}",  "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.0}",        "$type": "color" },
          "border":     { "$value": "{primitive.color.neutral.500}",      "$type": "color" }
        },
        "disabled": {
          "background": { "$value": "transparent",                        "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.500}",      "$type": "color" },
          "border":     { "$value": "{primitive.color.alpha.neutral.15}", "$type": "color" }
        }
      },
      "ghost": {
        "default": {
          "background": { "$value": "transparent",                    "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.300}", "$type": "color" },
          "border":     { "$value": "transparent",                    "$type": "color" }
        },
        "hover": {
          "background": { "$value": "{primitive.color.alpha.neutral.8}", "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.0}",       "$type": "color" },
          "border":     { "$value": "transparent",                        "$type": "color" }
        }
      }
    },

    "interactive": {
      "focus": {
        "ring":   { "$value": "{primitive.color.purple.100}",      "$type": "color" },
        "offset": { "$value": "{primitive.color.neutral.900}",     "$type": "color" }
      },
      "selection": {
        "background": { "$value": "{primitive.color.alpha.purple.15}", "$type": "color" },
        "foreground": { "$value": "{primitive.color.neutral.0}",       "$type": "color" }
      }
    }
  },

  "typography": {
    "display": {
      "hero": {
        "fontFamily":  { "$value": "{primitive.font.family.display}", "$type": "fontFamily" },
        "fontSize":    { "$value": "{primitive.font.size.7xl}",       "$type": "dimension" },
        "fontWeight":  { "$value": "{primitive.font.weight.light}",   "$type": "fontWeight" },
        "lineHeight":  { "$value": "{primitive.font.leading.tight}",  "$type": "number" },
        "letterSpacing":{ "$value": "{primitive.font.tracking.normal}","$type": "dimension" }
      },
      "title": {
        "fontFamily":  { "$value": "{primitive.font.family.display}", "$type": "fontFamily" },
        "fontSize":    { "$value": "{primitive.font.size.6xl}",       "$type": "dimension" },
        "fontWeight":  { "$value": "{primitive.font.weight.light}",   "$type": "fontWeight" },
        "lineHeight":  { "$value": "{primitive.font.leading.tight}",  "$type": "number" }
      },
      "section": {
        "fontFamily":  { "$value": "{primitive.font.family.display}", "$type": "fontFamily" },
        "fontSize":    { "$value": "{primitive.font.size.5xl}",       "$type": "dimension" },
        "fontWeight":  { "$value": "{primitive.font.weight.light}",   "$type": "fontWeight" },
        "lineHeight":  { "$value": "{primitive.font.leading.snug}",   "$type": "number" }
      }
    },
    "body": {
      "large": {
        "fontFamily": { "$value": "{primitive.font.family.body}", "$type": "fontFamily" },
        "fontSize":   { "$value": "{primitive.font.size.3xl}",    "$type": "dimension" },
        "fontWeight": { "$value": "{primitive.font.weight.light}", "$type": "fontWeight" },
        "lineHeight": { "$value": "{primitive.font.leading.normal}", "$type": "number" }
      },
      "default": {
        "fontFamily": { "$value": "{primitive.font.family.body}", "$type": "fontFamily" },
        "fontSize":   { "$value": "{primitive.font.size.xl}",     "$type": "dimension" },
        "fontWeight": { "$value": "{primitive.font.weight.light}", "$type": "fontWeight" },
        "lineHeight": { "$value": "{primitive.font.leading.loose}", "$type": "number" }
      },
      "small": {
        "fontFamily": { "$value": "{primitive.font.family.body}", "$type": "fontFamily" },
        "fontSize":   { "$value": "{primitive.font.size.md}",     "$type": "dimension" },
        "fontWeight": { "$value": "{primitive.font.weight.light}", "$type": "fontWeight" },
        "lineHeight": { "$value": "{primitive.font.leading.relaxed}", "$type": "number" }
      }
    },
    "label": {
      "default": {
        "fontFamily":   { "$value": "{primitive.font.family.body}",     "$type": "fontFamily" },
        "fontSize":     { "$value": "{primitive.font.size.sm}",         "$type": "dimension" },
        "fontWeight":   { "$value": "{primitive.font.weight.light}",    "$type": "fontWeight" },
        "lineHeight":   { "$value": "{primitive.font.leading.none}",    "$type": "number" },
        "letterSpacing":{ "$value": "{primitive.font.tracking.wide}",   "$type": "dimension" },
        "textTransform":{ "$value": "uppercase",                         "$type": "string" }
      },
      "caption": {
        "fontFamily": { "$value": "{primitive.font.family.body}",    "$type": "fontFamily" },
        "fontSize":   { "$value": "{primitive.font.size.xs}",        "$type": "dimension" },
        "fontWeight": { "$value": "{primitive.font.weight.light}",   "$type": "fontWeight" },
        "lineHeight": { "$value": "{primitive.font.leading.normal}", "$type": "number" }
      }
    }
  },

  "spacing": {
    "layout": {
      "pagePadding":  { "$value": "{primitive.space.4}",  "$type": "dimension" },
      "sectionGap":   { "$value": "{primitive.space.11}", "$type": "dimension" },
      "contentGap":   { "$value": "{primitive.space.7}",  "$type": "dimension" },
      "cardPadding":  { "$value": "{primitive.space.7}",  "$type": "dimension" },
      "inlineGap":    { "$value": "{primitive.space.2}",  "$type": "dimension" }
    },
    "component": {
      "button": {
        "paddingX": { "$value": "{primitive.space.4}", "$type": "dimension" },
        "paddingY": { "$value": "{primitive.space.2}", "$type": "dimension" },
        "gap":      { "$value": "{primitive.space.2}", "$type": "dimension" }
      },
      "card": {
        "padding": { "$value": "{primitive.space.6}", "$type": "dimension" },
        "gap":     { "$value": "{primitive.space.5}", "$type": "dimension" }
      },
      "input": {
        "paddingX": { "$value": "{primitive.space.3}", "$type": "dimension" },
        "paddingY": { "$value": "{primitive.space.2}", "$type": "dimension" }
      }
    }
  },

  "radius": {
    "component": {
      "button":  { "$value": "{primitive.radius.full}", "$type": "dimension" },
      "card":    { "$value": "{primitive.radius.md}",   "$type": "dimension" },
      "chip":    { "$value": "{primitive.radius.xs}",   "$type": "dimension" },
      "input":   { "$value": "{primitive.radius.xs}",   "$type": "dimension" },
      "image":   { "$value": "{primitive.radius.xs}",   "$type": "dimension" },
      "tooltip": { "$value": "{primitive.radius.sm}",   "$type": "dimension" },
      "sheet":   { "$value": "{primitive.radius.md}",   "$type": "dimension" }
    }
  },

  "motion": {
    "transition": {
      "interaction": {
        "duration": { "$value": "{primitive.motion.duration.fast}",    "$type": "duration" },
        "easing":   { "$value": "{primitive.motion.easing.out}",       "$type": "string" }
      },
      "reveal": {
        "duration": { "$value": "{primitive.motion.duration.slow}",    "$type": "duration" },
        "easing":   { "$value": "{primitive.motion.easing.default}",   "$type": "string" }
      },
      "enter": {
        "duration": { "$value": "{primitive.motion.duration.enter}",   "$type": "duration" },
        "easing":   { "$value": "{primitive.motion.easing.default}",   "$type": "string" }
      },
      "exit": {
        "duration": { "$value": "{primitive.motion.duration.base}",    "$type": "duration" },
        "easing":   { "$value": "{primitive.motion.easing.in}",        "$type": "string" }
      }
    }
  }
}
