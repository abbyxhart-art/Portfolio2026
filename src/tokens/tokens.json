{
  "_meta": {
    "format": "DTCG-compatible",
    "version": "2.0.0",
    "cssVarStrategy": "kebab-path — color.text.primary → --color-text-primary"
  },
  "primitive": {
    "color": {
      "neutral": {
        "_comment": "Dark mode scale — source of truth. 00=darkest, 100=lightest. Saturation trimmed ~35% off each step (same hue/value) to read as more neutral while keeping a slight purple cast.",
        "00":  { "$value": "#161617", "$type": "color" },
        "05":  { "$value": "#2F2F32", "$type": "color" },
        "10":  { "$value": "#424147", "$type": "color" },
        "20":  { "$value": "#5C5A64", "$type": "color" },
        "30":  { "$value": "#737278", "$type": "color" },
        "40":  { "$value": "#818087", "$type": "color" },
        "50":  { "$value": "#BDBAC5", "$type": "color" },
        "60":  { "$value": "#B2B0B9", "$type": "color" },
        "70":  { "$value": "#C4C3CB", "$type": "color" },
        "80":  { "$value": "#D5D3DC", "$type": "color" },
        "90":  { "$value": "#F0F0F5", "$type": "color" },
        "100": { "$value": "#FCFBFF", "$type": "color" }
      },
      "accent": {
        "100": { "$value": "#E9CBD8", "$type": "color" },
        "200": { "$value": "#D6A2B8", "$type": "color" },
        "300": { "$value": "#BC7F9D", "$type": "color" },
        "380": { "$value": "#995D7B", "$type": "color" }
      },
      "accent2": {
        "light": { "$value": "#00867D", "$type": "color" },
        "dark":  { "$value": "#00D3A7", "$type": "color" }
      }
    },
    "font": {
      "family": {
        "display": { "$value": "'Inter Tight', sans-serif", "$type": "fontFamily" },
        "body":    { "$value": "'Inter Tight', sans-serif", "$type": "fontFamily" }
      },
      "size": {
        "xs":  { "$value": "0.625rem",  "$type": "dimension" },
        "sm":  { "$value": "0.75rem",   "$type": "dimension" },
        "md":  { "$value": "0.875rem",  "$type": "dimension" },
        "base":{ "$value": "0.9375rem","$type": "dimension" },
        "lg":  { "$value": "1rem",      "$type": "dimension" },
        "xl":  { "$value": "1.0625rem", "$type": "dimension" },
        "2xl": { "$value": "1.125rem",  "$type": "dimension" },
        "3xl": { "$value": "1.25rem",   "$type": "dimension" },
        "4xl": { "$value": "1.5rem",    "$type": "dimension" },
        "5xl": { "$value": "1.75rem",   "$type": "dimension" },
        "6xl": { "$value": "2rem",      "$type": "dimension" },
        "7xl": { "$value": "2.5rem",    "$type": "dimension" },
        "8xl": { "$value": "3.25rem",   "$type": "dimension" }
      },
      "weight": {
        "light":   { "$value": 380, "$type": "fontWeight" },
        "regular": { "$value": 380, "$type": "fontWeight" },
        "medium":  { "$value": 450, "$type": "fontWeight" },
         "bold":  { "$value": 500, "$type": "fontWeight" }
      },
      "leading": {
        "none":    { "$value": 1,    "$type": "number" },
        "tight":   { "$value": 1.1,  "$type": "number" },
        "snug":    { "$value": 1.2,  "$type": "number" },
        "normal":  { "$value": 1.4,  "$type": "number" },
        "relaxed": { "$value": 1.75, "$type": "number" },
        "loose":   { "$value": 1.65, "$type": "number" }
      },
      "tracking": {
        "tight":  { "$value": "-0.01em", "$type": "dimension" },
        "normal": { "$value": "0em",     "$type": "dimension" },
        "wide":   { "$value": "0.08em",  "$type": "dimension" }
      }
    },
    "space": {
      "1":  { "$value": "4px",  "$type": "dimension" },
      "2":  { "$value": "8px",  "$type": "dimension" },
      "3":  { "$value": "12px", "$type": "dimension" },
      "4":  { "$value": "16px", "$type": "dimension" },
      "5":  { "$value": "20px", "$type": "dimension" },
      "6":  { "$value": "24px", "$type": "dimension" },
      "7":  { "$value": "32px", "$type": "dimension" },
      "8":  { "$value": "40px", "$type": "dimension" },
      "9":  { "$value": "48px", "$type": "dimension" },
      "10": { "$value": "64px", "$type": "dimension" },
      "11": { "$value": "80px", "$type": "dimension" },
      "12": { "$value": "96px", "$type": "dimension" }
    },
    "radius": {
      "xs":   { "$value": "4px",    "$type": "dimension" },
      "sm":   { "$value": "8px",    "$type": "dimension" },
      "md":   { "$value": "12px",   "$type": "dimension" },
      "lg":   { "$value": "24px",   "$type": "dimension" },
      "xl":   { "$value": "50px",   "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "motion": {
      "duration": {
        "instant": { "$value": "100ms",   "$type": "duration" },
        "fast":    { "$value": "150ms",   "$type": "duration" },
        "base":    { "$value": "200ms",   "$type": "duration" },
        "slow":    { "$value": "380ms",   "$type": "duration" },
        "enter":   { "$value": "1380ms",  "$type": "duration" }
      },
      "easing": {
        "default": { "$value": "cubic-bezier(0.33, 0, 0, 1)", "$type": "string" },
        "out":     { "$value": "ease-out",                    "$type": "string" },
        "in":      { "$value": "ease-in",                     "$type": "string" },
        "linear":  { "$value": "linear",                      "$type": "string" }
      }
    }
  },

  "color": {
    "background": {
      "page": { "$value": "{primitive.color.neutral.00}", "$type": "color" }
    },
    "surface": {
      "primary": { "$value": "{primitive.color.neutral.00}", "$type": "color" },
      "ghost":   { "$value": "rgba(22,22,23,0.05)",          "$type": "color" },
      "fill1":   { "$value": "rgba(144,142,153,0.50)", "$type": "color" },
      "fill2":   { "$value": "rgba(144,142,153,0.20)", "$type": "color" },
      "fill3":   { "$value": "rgba(88,85,100,0.70)",   "$type": "color" },
      "layer1":  { "$value": "rgba(46,45,50,0.9)",   "$type": "color" },
      "layer2":  { "$value": "rgba(66,65,71,0.85)",  "$type": "color" },
      "secondary": {
        "default": { "$value": "{primitive.color.neutral.05}", "$type": "color" },
        "hover":   { "$value": "rgba(88,85,100,0.18)",         "$type": "color" },
        "active":  { "$value": "rgba(88,85,100,0.28)",         "$type": "color" }
      },
      "tertiary": { "$value": "{primitive.color.neutral.10}", "$type": "color" },
      "overlay": {
        "default": { "$value": "rgba(22,22,23,0.85)", "$type": "color" },
        "strong":  { "$value": "rgba(22,22,23,0.98)", "$type": "color" },
        "fade":    { "$value": "rgba(22,22,23,0.35)", "$type": "color" }
      }
    },
    "text": {
      "primary":   { "$value": "{primitive.color.neutral.100}", "$type": "color" },
      "between":   { "$value": "{primitive.color.neutral.70}",  "$type": "color" },
      "secondary": { "$value": "{primitive.color.neutral.40}",  "$type": "color" },
      "tertiary":  { "$value": "{primitive.color.neutral.20}",  "$type": "color" },
      "light":     { "$value": "{primitive.color.neutral.10}",  "$type": "color" },
      "disabled":  { "$value": "{primitive.color.neutral.40}",  "$type": "color" },
      "inverse":   { "$value": "{primitive.color.neutral.00}",  "$type": "color" },
      "accent":    { "$value": "{primitive.color.accent.200}",  "$type": "color" }
    },
    "border": {
      "default": { "$value": "rgba(174,171,185,0.2)",        "$type": "color" },
      "light":   { "$value": "{primitive.color.neutral.60}", "$type": "color" },
      "dark":    { "$value": "{primitive.color.neutral.05}", "$type": "color" },
      "subtle":  { "$value": "rgba(88,85,100,0.12)",         "$type": "color" },
      "strong":  { "$value": "{primitive.color.neutral.30}", "$type": "color" },
      "focus":   { "$value": "{primitive.color.accent.200}", "$type": "color" }
    },
    "accent": {
      "default": { "$value": "{primitive.color.accent.200}",  "$type": "color" },
      "vibrant": { "$value": "{primitive.color.accent.300}",  "$type": "color" },
      "subtle":  { "$value": "rgba(214,162,184,0.08)",        "$type": "color" },
      "muted":   { "$value": "rgba(214,162,184,0.15)",        "$type": "color" },
      "strong":  { "$value": "rgba(214,162,184,0.20)",        "$type": "color" }
    },
    "button": {
      "default": {
        "fill":   { "$value": "{color.surface.layer1}",    "$type": "color" },
        "label":  { "$value": "{primitive.color.neutral.40}",  "$type": "color" },
        "hover": {
          "fill":  { "$value": "{color.surface.layer2}",    "$type": "color" },
          "label": { "$value": "{primitive.color.neutral.100}", "$type": "color" }
        },
        "border": { "$value": "{primitive.color.neutral.05}", "$type": "color" }
      },
      "primary": {
        "default": {
          "background": { "$value": "{primitive.color.neutral.100}", "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.00}",  "$type": "color" },
          "border":     { "$value": "transparent",                    "$type": "color" }
        },
        "hover": {
          "background": { "$value": "{primitive.color.neutral.90}",  "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.00}",  "$type": "color" },
          "border":     { "$value": "transparent",                    "$type": "color" }
        },
        "disabled": {
          "background": { "$value": "rgba(88,85,100,0.18)",         "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.40}", "$type": "color" },
          "border":     { "$value": "transparent",                   "$type": "color" }
        }
      },
      "secondary": {
        "default": {
          "background": { "$value": "transparent",                    "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.100}", "$type": "color" },
          "border":     { "$value": "{primitive.color.neutral.20}",  "$type": "color" }
        },
        "hover": {
          "background": { "$value": "rgba(88,85,100,0.10)",         "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.100}", "$type": "color" },
          "border":     { "$value": "{primitive.color.neutral.40}", "$type": "color" }
        },
        "disabled": {
          "background": { "$value": "transparent",                   "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.40}", "$type": "color" },
          "border":     { "$value": "rgba(88,85,100,0.15)",         "$type": "color" }
        }
      },
      "ghost": {
        "default": {
          "background": { "$value": "transparent",                   "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.40}", "$type": "color" },
          "border":     { "$value": "transparent",                   "$type": "color" }
        },
        "hover": {
          "background": { "$value": "rgba(88,85,100,0.10)",         "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.100}", "$type": "color" },
          "border":     { "$value": "transparent",                   "$type": "color" }
        }
      },
      "link": {
        "default": {
          "background": { "$value": "rgba(22,22,23,0.30)",          "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.40}", "$type": "color" },
          "border":     { "$value": "{primitive.color.neutral.05}", "$type": "color" }
        },
        "hover": {
          "background": { "$value": "rgba(88,85,100,0.25)",         "$type": "color" },
          "foreground": { "$value": "{primitive.color.neutral.70}", "$type": "color" },
          "border":     { "$value": "{primitive.color.neutral.20}", "$type": "color" }
        }
      }
    },
    "interactive": {
      "focus": {
        "ring":   { "$value": "{primitive.color.accent.200}", "$type": "color" },
        "offset": { "$value": "{primitive.color.neutral.00}", "$type": "color" }
      },
      "selection": {
        "background": { "$value": "#AE77D5",              "$type": "color" },
        "foreground": { "$value": "{color.background.page}", "$type": "color" }
      }
    },
    "accent2": {
      "background": { "$value": "rgba(0,211,167,0.30)",           "$type": "color" },
      "foreground": { "$value": "{primitive.color.accent2.dark}", "$type": "color" }
    }
  },

  "typography": {
    "weight": {
      "regular": { "$value": "{primitive.font.weight.regular}", "$type": "fontWeight" },
      "medium":  { "$value": "{primitive.font.weight.medium}",  "$type": "fontWeight" },
      "bold":    { "$value": "{primitive.font.weight.bold}",    "$type": "fontWeight" }
    },
    "display": {
      "hero": {
        "fontFamily":    { "$value": "{primitive.font.family.display}", "$type": "fontFamily" },
        "fontSize":      { "$value": "{primitive.font.size.7xl}",       "$type": "dimension" },
        "fontWeight":    { "$value": "{primitive.font.weight.light}",   "$type": "fontWeight" },
        "lineHeight":    { "$value": "{primitive.font.leading.tight}",  "$type": "number" },
        "letterSpacing": { "$value": "{primitive.font.tracking.normal}","$type": "dimension" }
      },
      "title": {
        "fontFamily": { "$value": "{primitive.font.family.display}", "$type": "fontFamily" },
        "fontSize":   { "$value": "{primitive.font.size.6xl}",       "$type": "dimension" },
        "fontWeight": { "$value": "{primitive.font.weight.light}",   "$type": "fontWeight" },
        "lineHeight": { "$value": "{primitive.font.leading.tight}",  "$type": "number" }
      },
      "section": {
        "fontFamily": { "$value": "{primitive.font.family.display}", "$type": "fontFamily" },
        "fontSize":   { "$value": "{primitive.font.size.5xl}",       "$type": "dimension" },
        "fontWeight": { "$value": "{primitive.font.weight.light}",   "$type": "fontWeight" },
        "lineHeight": { "$value": "{primitive.font.leading.snug}",   "$type": "number" }
      },
      "titleSmallest": {
        "fontFamily": { "$value": "{primitive.font.family.display}", "$type": "fontFamily" },
        "fontSize":   { "$value": "{primitive.font.size.3xl}",       "$type": "dimension" },
        "fontWeight": { "$value": "{primitive.font.weight.medium}",  "$type": "fontWeight" },
        "lineHeight": { "$value": 1.45,                              "$type": "number" }
      }
    },
    "body": {
      "large": {
        "fontFamily": { "$value": "{primitive.font.family.body}",    "$type": "fontFamily" },
        "fontSize":   { "$value": "{primitive.font.size.3xl}",       "$type": "dimension" },
        "fontWeight": { "$value": "{primitive.font.weight.light}",   "$type": "fontWeight" },
        "lineHeight": { "$value": "{primitive.font.leading.normal}", "$type": "number" }
      },
      "default": {
        "fontFamily": { "$value": "{primitive.font.family.body}",     "$type": "fontFamily" },
        "fontSize":   { "$value": "{primitive.font.size.lg}",         "$type": "dimension" },
        "fontWeight": { "$value": "{primitive.font.weight.light}",    "$type": "fontWeight" },
        "lineHeight": { "$value": "{primitive.font.leading.relaxed}", "$type": "number" }
      },
      "defaultIntense": {
        "fontFamily": { "$value": "{primitive.font.family.body}",     "$type": "fontFamily" },
        "fontSize":   { "$value": "{primitive.font.size.lg}",         "$type": "dimension" },
        "fontWeight": { "$value": "{primitive.font.weight.medium}",   "$type": "fontWeight" },
        "lineHeight": { "$value": "{primitive.font.leading.relaxed}", "$type": "number" }
      },
      "small": {
        "fontFamily": { "$value": "{primitive.font.family.body}",     "$type": "fontFamily" },
        "fontSize":   { "$value": "{primitive.font.size.md}",         "$type": "dimension" },
        "fontWeight": { "$value": "{primitive.font.weight.light}",    "$type": "fontWeight" },
        "lineHeight": { "$value": "{primitive.font.leading.relaxed}", "$type": "number" }
      }
    },
    "label": {
      "default": {
        "fontFamily":    { "$value": "{primitive.font.family.body}",   "$type": "fontFamily" },
        "fontSize":      { "$value": "{primitive.font.size.sm}",        "$type": "dimension" },
        "fontWeight":    { "$value": "{primitive.font.weight.light}",   "$type": "fontWeight" },
        "lineHeight":    { "$value": "{primitive.font.leading.none}",   "$type": "number" },
        "letterSpacing": { "$value": "{primitive.font.tracking.wide}",  "$type": "dimension" },
        "textTransform": { "$value": "uppercase",                        "$type": "string" }
      },
      "caption": {
        "fontFamily": { "$value": "{primitive.font.family.body}",    "$type": "fontFamily" },
        "fontSize":   { "$value": "{primitive.font.size.xs}",        "$type": "dimension" },
        "fontWeight": { "$value": "{primitive.font.weight.light}",   "$type": "fontWeight" },
        "lineHeight": { "$value": "{primitive.font.leading.normal}", "$type": "number" }
      }
    }
  },

  "spacing": {
    "layout": {
      "pagePadding": { "$value": "{primitive.space.4}",  "$type": "dimension" },
      "sectionGap":  { "$value": "{primitive.space.11}", "$type": "dimension" },
      "contentGap":  { "$value": "{primitive.space.7}",  "$type": "dimension" },
      "cardPadding": { "$value": "{primitive.space.7}",  "$type": "dimension" },
      "inlineGap":   { "$value": "{primitive.space.2}",  "$type": "dimension" }
    },
    "component": {
      "button": {
        "paddingX": { "$value": "{primitive.space.4}", "$type": "dimension" },
        "paddingY": { "$value": "{primitive.space.2}", "$type": "dimension" },
        "gap":      { "$value": "{primitive.space.2}", "$type": "dimension" }
      },
      "card": {
        "padding": { "$value": "{primitive.space.6}", "$type": "dimension" },
        "gap":     { "$value": "{primitive.space.5}", "$type": "dimension" }
      },
      "input": {
        "paddingX": { "$value": "{primitive.space.3}", "$type": "dimension" },
        "paddingY": { "$value": "{primitive.space.2}", "$type": "dimension" }
      }
    }
  },

  "radius": {
    "component": {
      "button":  { "$value": "{primitive.radius.full}", "$type": "dimension" },
      "card":    { "$value": "{primitive.radius.md}",   "$type": "dimension" },
      "chip":    { "$value": "{primitive.radius.xs}",   "$type": "dimension" },
      "input":   { "$value": "{primitive.radius.xs}",   "$type": "dimension" },
      "image":   { "$value": "{primitive.radius.md}",   "$type": "dimension" },
      "tooltip": { "$value": "{primitive.radius.sm}",   "$type": "dimension" },
      "sheet":   { "$value": "{primitive.radius.md}",   "$type": "dimension" }
    }
  },

  "gap": {
    "_comment": "Figma's gap/section is a fixed 64px. Here it's viewport-relative instead, so section rhythm scales with available height rather than staying flat — whenever Figma MCP output references gap/section, substitute var(--gap-section) instead of its literal 64px fallback.",
    "section": { "$value": "8svh", "$type": "dimension" }
  },

  "motion": {
    "transition": {
      "interaction": {
        "duration": { "$value": "{primitive.motion.duration.fast}", "$type": "duration" },
        "easing":   { "$value": "{primitive.motion.easing.out}",   "$type": "string" }
      },
      "reveal": {
        "duration": { "$value": "{primitive.motion.duration.slow}",    "$type": "duration" },
        "easing":   { "$value": "{primitive.motion.easing.default}",   "$type": "string" }
      },
      "enter": {
        "duration": { "$value": "{primitive.motion.duration.enter}",   "$type": "duration" },
        "easing":   { "$value": "{primitive.motion.easing.default}",   "$type": "string" }
      },
      "exit": {
        "duration": { "$value": "{primitive.motion.duration.base}",    "$type": "duration" },
        "easing":   { "$value": "{primitive.motion.easing.in}",        "$type": "string" }
      }
    }
  }
}
